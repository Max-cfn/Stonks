# Stonks — Environment Variables Template
# Copy to .env and fill in real values.
# NEVER commit .env to Git.

# ── Application ────────────────────────────────────────────────────
STONKS_ENV=dev
STONKS_DEBUG=true
STONKS_LOG_LEVEL=INFO
STONKS_LOG_FORMAT=console

# ── Database (PostgreSQL 16 + TimescaleDB) ─────────────────────────
STONKS_DATABASE_URL=postgresql+asyncpg://stonks:stonks_dev@localhost:5432/stonks_dev
STONKS_DATABASE_POOL_SIZE=10
STONKS_DATABASE_MAX_OVERFLOW=20
STONKS_DATABASE_ECHO=false

# ── Redis ──────────────────────────────────────────────────────────
STONKS_REDIS_URL=redis://localhost:6379/0

# ── Vault ──────────────────────────────────────────────────────────
STONKS_VAULT_URL=http://localhost:8200
STONKS_VAULT_TOKEN=dev-token
STONKS_VAULT_MOUNT_POINT=secret
STONKS_VAULT_ENABLED=true

# ── JWT ────────────────────────────────────────────────────────────
# Dev default — in prod this comes from Vault
STONKS_JWT_SECRET=dev-secret-change-me-in-production-use-at-least-256-bits
STONKS_JWT_ALGORITHM=HS256
STONKS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
STONKS_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
STONKS_JWT_ISSUER=stonks-backend

# ── AES-256-GCM ────────────────────────────────────────────────────
# Must be exactly 32 bytes; base64-encode a 256-bit key
# In prod this comes from Vault
STONKS_AES_KEY=KsNfp1LlUVU77Kb1R0nclzLvqcIIIjuOStCGYHlKMU8=

# ── Rate Limiting ──────────────────────────────────────────────────
STONKS_RATE_LIMIT_AUTH_LOGIN=5/minute
STONKS_RATE_LIMIT_GLOBAL=100/minute

# ── CORS ───────────────────────────────────────────────────────────
STONKS_CORS_ORIGINS=["http://localhost:4173"]
NEXT_PUBLIC_API_URL=http://localhost:4174

# ── DeepSeek / LLM ─────────────────────────────────────────────────
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_MODEL=deepseek/deepseek-chat

# ── GitHub ─────────────────────────────────────────────────────────
GITHUB_TOKEN=your-github-token
GITHUB_REPO_OWNER=Max-cfn
GITHUB_REPO_NAME=Stonks

# ─── Auto-approve policy (pour briefs autonomes 24/7) ─────────────────
# Niveau de confiance accordé à l'orchestrateur quand tu n'es pas devant.
# Valeurs : off | conservative | moderate | yolo
#
# off          : (défaut) toute approbation passe par toi via UI / REPL
# conservative : auto-approuve les actions sandbox local sûres
#                (file_read, file_write dans /opt/stonks, pnpm/uv install,
#                 git branch/commit, gitnexus index, pytest, ruff, etc.)
#                Bloque toujours : push main, suppression DB, force-push,
#                rm -rf hors /opt/stonks, etc.
# moderate     : conservative + git push branches agent/*, ouverture PR,
#                migrations Alembic upgrade, appels LLM jusqu'à $5
# yolo         : auto-approuve TOUT sauf les hard-blocks (rm -rf /, force
#                push main/master, drop database, chmod 777, sudo rm…)
#
# Tu peux aussi pointer vers un fichier YAML/JSON custom (override total) :
# STONKS_AUTOAPPROVE_POLICY=/opt/stonks/configs/my_policy.yaml
STONKS_AUTOAPPROVE_LEVEL=off
# Plafond de coût LLM auto-approuvé par appel (USD). Au-delà → bloque.
STONKS_AUTOAPPROVE_BUDGET_LIMIT_USD=5.0
