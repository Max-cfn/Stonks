# Stonks — Environment Variables Template
# Copy to .env and fill in real values.
# NEVER commit .env to Git.

# ── Application ────────────────────────────────────────────────────
STONKS_ENV=dev
STONKS_DEBUG=true
STONKS_LOG_LEVEL=INFO
STONKS_LOG_FORMAT=console

# ── Database (PostgreSQL 16 + TimescaleDB) ─────────────────────────
STONKS_DATABASE_URL=postgresql+asyncpg://stonks:stonks_dev@localhost:5432/stonks_dev
STONKS_DATABASE_POOL_SIZE=10
STONKS_DATABASE_MAX_OVERFLOW=20
STONKS_DATABASE_ECHO=false

# ── Redis ──────────────────────────────────────────────────────────
STONKS_REDIS_URL=redis://localhost:6379/0

# ── Vault ──────────────────────────────────────────────────────────
STONKS_VAULT_URL=http://localhost:8200
STONKS_VAULT_TOKEN=dev-token
STONKS_VAULT_MOUNT_POINT=secret
STONKS_VAULT_ENABLED=true

# ── JWT ────────────────────────────────────────────────────────────
# Dev default — in prod this comes from Vault
STONKS_JWT_SECRET=dev-secret-change-me-in-production-use-at-least-256-bits
STONKS_JWT_ALGORITHM=HS256
STONKS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
STONKS_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
STONKS_JWT_ISSUER=stonks-backend

# ── AES-256-GCM ────────────────────────────────────────────────────
# AES-256-GCM master key: exactly 32 random bytes, encoded in base64.
# Generate with: python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# In production this comes from Vault.
STONKS_AES_KEY=<base64 of 32 random bytes — generate as described above>

# ── Rate Limiting ──────────────────────────────────────────────────
STONKS_RATE_LIMIT_AUTH_LOGIN=5/minute
STONKS_RATE_LIMIT_GLOBAL=100/minute

# ── CORS ───────────────────────────────────────────────────────────
STONKS_CORS_ORIGINS=["http://localhost:4173"]
NEXT_PUBLIC_API_URL=http://localhost:4174

# ── DeepSeek / LLM ─────────────────────────────────────────────────
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_MODEL=deepseek/deepseek-chat

# ── GitHub ─────────────────────────────────────────────────────────
GITHUB_TOKEN=your-github-token
GITHUB_REPO_OWNER=Max-cfn
GITHUB_REPO_NAME=Stonks

# ── Enable Banking (PSD2/OAuth aggregator) ─────────────────────────
ENABLE_BANKING_APPLICATION_ID=your-app-id
ENABLE_BANKING_PRIVATE_KEY_PATH=./secrets/enablebanking.pem
ENABLE_BANKING_SANDBOX=true

# ── CoinGecko / Market Data ────────────────────────────────────────
COINGECKO_API_KEY=your-coingecko-api-key
ALPHAVANTAGE_API_KEY=your-alphavantage-api-key

# ── News RSS Feeds (Analyst Agent) ─────────────────────────────────
NEWS_RSS_FEEDS=https://www.bloomberg.com/feed/podcast/etf-report.xml,https://feeds.reuters.com/reuters/businessNews

# ── WebSocket (Next.js public env, for browser) ─────────────────────
NEXT_PUBLIC_WS_URL=http://localhost:4174
NEXT_PUBLIC_API_URL=http://localhost:4174
