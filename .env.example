# ╔══════════════════════════════════════════════════════════════════════╗
# ║  STONKS — Variables d'environnement                                  ║
# ║                                                                      ║
# ║  Copie ce fichier vers .env et remplis les valeurs.                  ║
# ║  Ne commit JAMAIS le .env (il est dans .gitignore).                  ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ─── LLM / Orchestrateur ──────────────────────────────────────────────
# OpenRouter API (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modèle principal de l'Orchestrateur. DeepSeek V4 Pro = MoE 1.6T, 1M ctx, $0.435/M input.
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
# Modèle pour les sous-agents légers (review, classification, etc.)
OPENROUTER_MODEL_LIGHT=deepseek/deepseek-v4-flash
# Reasoning effort : "low", "medium", "high", "xhigh" (xhigh = max).
OPENROUTER_REASONING_EFFORT=high
# Temperature pour l'orchestrateur (gardez basse pour la rigueur).
OPENROUTER_TEMPERATURE=0.2
# Limite de tokens par appel (sécurité budget).
OPENROUTER_MAX_TOKENS=32000
# Optionnel : Headers HTTP-Referer et X-Title (apparaissent dans les stats OpenRouter).
OPENROUTER_HTTP_REFERER=https://github.com/Max-cfn/Stonks
OPENROUTER_X_TITLE=Stonks-Orchestrator

# ─── Repository cible ─────────────────────────────────────────────────
TARGET_GITHUB_REPO=Max-cfn/Stonks
GITHUB_DEFAULT_BRANCH=main
# Token GitHub pour les opérations Git/PR (scopes: repo, workflow).
# Sur serveurmax, l'orchestrateur l'utilise via gh CLI ; définissez-le si vous lancez ailleurs.
GITHUB_TOKEN=

# Repo de référence pour Phase 2 (analyse de Picsou-finance pour reprendre les concepts PSD2).
REFERENCE_REPO_PICSOU=Zoeille/picsou-finance

# ─── Base de données (Phase 2) ────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stonks
POSTGRES_USER=stonks
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://stonks:change_me_in_production@localhost:5432/stonks

# TimescaleDB pour les séries temporelles boursières (Phase 2).
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_DB=stonks_ts
TIMESCALE_USER=stonks_ts
TIMESCALE_PASSWORD=change_me_in_production
TIMESCALE_URL=postgresql+asyncpg://stonks_ts:change_me_in_production@localhost:5433/stonks_ts

# Redis (queue agents + cache prix temps réel).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ─── Sécurité (Phase 2) ───────────────────────────────────────────────
# Clé maîtresse AES-256 (32 bytes en base64). Génération : openssl rand -base64 32
APP_MASTER_KEY=
# Clé de signature JWT (min. 32 caractères).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Vault local (HashiCorp Vault dev mode pour Phase 2).
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# ─── Agrégation bancaire (Phase 2) ────────────────────────────────────
# Enable Banking PSD2/OAuth — https://enablebanking.com/
ENABLEBANKING_APPLICATION_ID=
ENABLEBANKING_PRIVATE_KEY_PATH=./secrets/enablebanking.pem

# ─── Données de marché (Phase 2) ──────────────────────────────────────
# CoinGecko (gratuit pour usage modéré, sinon clé Pro).
COINGECKO_API_KEY=
# Yahoo Finance via yfinance (pas de clé requise).
# Alpha Vantage (alternative, gratuit avec rate limit).
ALPHAVANTAGE_API_KEY=

# ─── Flux d'actualités (Agent Analyste — Phase 2) ─────────────────────
# Liste de flux RSS séparés par des virgules.
NEWS_RSS_FEEDS=https://www.bloomberg.com/feed/podcast/etf-report.xml,https://feeds.reuters.com/reuters/businessNews

# ─── Agents runtime ───────────────────────────────────────────────────
# Niveau de log : DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Chemin absolu du execution_log.txt (rigueur impose la racine du repo).
EXECUTION_LOG_PATH=/opt/stonks/execution_log.txt
# Limite de tokens cumulés par session orchestrateur (garde-fou budget).
ORCHESTRATOR_TOKEN_BUDGET=10000000
# Confirmation humaine requise avant les actions critiques (oui/non).
REQUIRE_HUMAN_CONFIRMATION=true
# Nombre max d'itérations sans validation humaine (anti-boucle infinie).
MAX_AUTONOMOUS_ITERATIONS=200

# ─── UI Monitoring ────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ─── Notifications (Phase 2) ──────────────────────────────────────────
# Telegram (alertes critiques de l'orchestrateur, prix de marché).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── GitNexus ─────────────────────────────────────────────────────────
GITNEXUS_BACKEND_URL=http://localhost:4747
