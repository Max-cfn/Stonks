# Stonks monorepo — configuration pnpm

# Autorise la purge silencieuse de node_modules (pas de TTY sur serveur headless)
confirmModulesPurge=false

# Résout les avertissements "Ignored build scripts" — voir pnpm-workspace.yaml
# pour la allowlist complète des packages autorisés à compiler du code natif.
onlyBuiltDependencies:
  - '@ladybugdb/core'
  - tree-sitter
  - tree-sitter-c
  - tree-sitter-c-sharp
  - tree-sitter-cli
  - tree-sitter-cpp
  - tree-sitter-go
  - tree-sitter-java
  - tree-sitter-javascript
  - tree-sitter-kotlin
  - tree-sitter-php
  - tree-sitter-python
  - tree-sitter-ruby
  - tree-sitter-rust
  - tree-sitter-typescript
